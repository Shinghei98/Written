# Required only for the Postgres worker. Keep the service-role database URL on
# the server; never embed it in the iOS app.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Optional human-readable process prefix. Each claim still receives a fresh
# random lease token, so two processes cannot acknowledge one another's work.
WORKER_ID=written-ontology-local

# Required by a production Calendar-classification handler. Use a randomly
# generated deployment secret from the server secret manager; rotate through a
# versioned signer so existing lineages remain replayable. The standalone CSV
# inspector deliberately uses a non-secret deterministic key and must not write
# its hashes to production.
CALENDAR_LINEAGE_HMAC_KEY=replace-with-a-secret-of-at-least-32-random-bytes
