<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The worker-queue consumer, every ten minutes (owner, 2026-08-26).

     Install (once):
       mkdir -p ~/.written && chmod 700 ~/.written
       printf 'WRITTEN_DATABASE_URL=postgresql://...\n' > ~/.written/env
       chmod 600 ~/.written/env
       cp tools/com.written.worker-queue.plist ~/Library/LaunchAgents/
       launchctl load ~/Library/LaunchAgents/com.written.worker-queue.plist

     The credential lives only in ~/.written/env (mode 600, outside the
     repository); this file carries none. Logs land in ~/.written/. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.written.worker-queue</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-c</string>
    <string>set -a; source ~/.written/env; set +a; exec /usr/bin/env python3 /Users/shingheimok/dev/WrittenApp/tools/run_worker_queue.py</string>
  </array>
  <key>StartInterval</key>
  <integer>600</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/shingheimok/.written/worker-queue.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/shingheimok/.written/worker-queue.err</string>
</dict>
</plist>
