{
  "_comment": [
    "A recorded-shape Microsoft Graph response, hand-built to the v1.0 schema",
    "rather than captured from a real tenant — registering an Entra application",
    "turned out to be days of Microsoft account plumbing and the parse should",
    "not have waited on it. Every field name and every enum value here is from",
    "Graph's own documented calendarView shape; nothing about anybody real is",
    "in it. `-probe-outlook` drives OutlookCalendarDistiller.shape over this.",
    "",
    "Each event is present to exercise one decision, named in its _why."
  ],
  "calendars": [
    {
      "calendar": { "id": "cal-primary", "name": "Calendar" },
      "events": [
        {
          "_why": "the ordinary case: an arranged, readable, single event",
          "id": "evt-dinner",
          "iCalUId": "uid-dinner",
          "subject": "Dinner at Yardbird",
          "start": { "dateTime": "2026-08-20T19:30:00.0000000", "timeZone": "Asia/Hong_Kong" },
          "end": { "dateTime": "2026-08-20T21:30:00.0000000", "timeZone": "Asia/Hong_Kong" },
          "isAllDay": false,
          "isCancelled": false,
          "sensitivity": "normal",
          "categories": ["Personal"],
          "showAs": "busy",
          "type": "singleInstance"
        },
        {
          "_why": "ahead of now, and the reason the window reaches five years forward",
          "id": "evt-flight",
          "iCalUId": "uid-flight",
          "subject": "Flight to Los Angeles (UA 1103)",
          "start": { "dateTime": "2026-11-02T08:15:00.0000000", "timeZone": "UTC" },
