<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- This file used to declare that nothing was collected. That was true when
	     a distillation lived and died on the device; it stopped being true the
	     moment records started landing in Postgres. Everything below is linked to
	     identity — every row is keyed by `auth.uid()` — and none of it is used for
	     tracking. The only purpose is app functionality: the profile is the
	     product.

	     Raw HealthKit rows are deliberately absent because they are never
	     uploaded, and that is enforced twice rather than merely intended: the
	     device derives its signals and discards the raw workouts and activity
	     samples without writing them to disk, and `SyncService.localOnlySources`
	     refuses the source outright. Only the derived signals below travel. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<!-- The name typed on the sign-up screen, or given once by Apple. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeName</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- Contacts, and only when Sync contacts is switched on in Settings →
		     Block list. Names alone are read; no phone numbers or email
		     addresses are taken, and the names that are kept are the ones the
		     user is blocking. They travel with the ban list to Postgres, which
		     is why this is declared at all — a purely on-device match would
		     not be collection. -->
		<dict>
			<key>NSPrivacyCollectedDataTypeCollected</key>
			<string>NSPrivacyCollectedDataTypeContacts</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- Sign in with Apple returns an address — often a private relay — and
		     Sign in with Google returns a real one. Either way the auth provider
		     stores it against the account. The app never asks for it, but it is
		     collected, so it is declared. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeEmailAddress</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- The third way in. Phone sign-in landed after this file was written
		     and the omission is the shape of mistake this manifest is most prone
		     to: everything here was true of the app on the day it was last read,
		     and a sign-in route is exactly the kind of thing added without
		     anybody thinking of a plist.

		     Supabase stores the E.164 number against the account and Twilio
		     Verify sees it once, to send a code. It is shown to no other user —
		     `discovery_cards` carries a first name, an age and a district and
		     nothing else — but it is collected, which is what this list is
		     about. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePhoneNumber</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- The account id every other row hangs off. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- Coarse, and only coarse: one reverse-geocoded fix, of which the
		     district and city are kept and the coordinate is discarded. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeCoarseLocation</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- Derived from HealthKit, never the raw samples: a chronotype band, a
		     median wake time, and sport names with session counts. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeFitness</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- What the distillation actually is, kept current as extraction has
		     widened. This is the entry that has to be re-read every time a
		     source is added or a field stops being discarded, because the whole
		     value of the list in CLAUDE.md is that it stays short *and*
		     complete.

		     From the apps a person connected: songs, artists, albums,
		     composers, playlists, play counts, skip counts, ratings and when
		     each was last played; YouTube subscriptions, liked videos and the
		     categories and topics YouTube assigns them; podcast shows and the
		     downloaded episodes of each, including how far through one somebody
		     got.

		     Two things worth naming rather than leaving implied. The music comes
		     from *two* places — the Apple Music account and the device's own
		     library — which are different observations about the same person
		     and are stored as different sources. And what somebody types into
		     "what did we miss" travels here too: it is a claim rather than an
		     observation, marked as such, but it is still collected.

		     All of it is app functionality: it builds the profile the person
		     came here to build. None of it is tracking, and none is shared with
		     a third party — see the lyrics note in CLAUDE.md for the single
		     exception, which sends one artist and one title and no identifier. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUsageData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- Age and gender typed on the biographics rows, and calendar events:
		     titles, locations, organisers and dates. One entry because Apple has
		     no calendar-specific type and a second "other" dict would be the same
		     declaration twice.

		     The calendar half is the only thing here carrying *other people's*
		     information — an event called "Dinner with Sam at 14 Elm St" names
		     someone who never agreed to anything. Events are kept whole rather
		     than reduced to counts, the way HealthKit is, because the titles are
		     the signal: a booking Eventbrite or Ticketmaster wrote into the
		     calendar is the strongest interest claim this app can see.

		     **Stored whole, shown as shape.** The dashboard prints how much was
		     arranged, how much was booked ahead, evenings, weekends and the
		     busiest day — and never a title. That is a display decision and
		     changes nothing here: every event is still collected and still
		     synced, because the ontology stage will need them. This declaration
		     describes what is *collected*, which is the stronger claim of the
		     two and the one that has to be right.

		     Subscribed and birthday calendars are no longer collected at all.
		     A public calendar is identical for everyone who subscribes to it, so
		     it says nothing about the subscriber, and a birthday list is
		     somebody's contacts by another route. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherDataTypes</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- The recorded half of a message.
		     A voice memo is a message like any other: it is held to record, kept
		     on the device until the send arrow is tapped, then uploaded to the
		     private `chat-media` bucket and readable only by the two people in
		     that conversation. Discarding a take deletes the file.
		     Declared here rather than left under "other" because audio is the
		     kind of thing a reader of this manifest would look for by name, and
		     a manifest that is technically complete but hard to search is the
		     kind that ages into a rejection. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeAudioData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- The written half, which the entry above was quietly standing in for.
		     Its comment said "messages, which now includes recorded audio" — so
		     the typed text of every conversation was declared only by the type
		     named for sound, which is the one place in this list a reader
		     searching for "messages" would not look.

		     Text, and the caption on a photograph or a video. Readable by the
		     two people in the conversation and by nobody else: `messages` is
		     `auth.uid()`-scoped to the two participants, which is also why the
		     unread query needs no conversation filter. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeEmailsOrTextMessages</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- Photographs and video, in two places with different audiences.
		     Up to six profile photographs in the private `profile-photos`
		     bucket, which the discovery card points at and any signed-in user
		     may therefore see — that is the product. And photographs and videos
		     sent in a conversation, in `chat-media`, which only the two people
		     in it can reach.

		     **A dating app not declaring photographs is the omission a reviewer
		     finds first**, and this one had gone unnoticed since `0015` because
		     the manifest was last read before the photo grid existed. Neither
		     bucket is public; both are read through links that expire. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePhotosorVideos</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>

	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<!-- UserDefaults: the tree seed, the ban list, and the debug launch
			     arguments. CA92.1 is the reason for access confined to the app
			     itself — nothing here is shared with an app group or another
			     process. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
