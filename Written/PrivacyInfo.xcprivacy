<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- This file used to declare that nothing was collected. That was true when
	     a distillation lived and died on the device; it stopped being true the
	     moment records started landing in Postgres. Everything below is linked to
	     identity — every row is keyed by `auth.uid()` — and none of it is used for
	     tracking. The only purpose is app functionality: the profile is the
	     product.

	     Raw HealthKit rows are deliberately absent because they are never
	     uploaded, and that is enforced twice rather than merely intended: the
	     device derives its signals and discards the raw workouts and activity
	     samples without writing them to disk, and `SyncService.localOnlySources`
	     refuses the source outright. Only the derived signals below travel. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<!-- The name typed on the sign-up screen, or given once by Apple. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeName</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- Sign in with Apple returns an address — often a private relay — and
		     the auth provider stores it against the account. The app never asks
		     for it, but it is collected, so it is declared. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeEmailAddress</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- The account id every other row hangs off. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- Coarse, and only coarse: one reverse-geocoded fix, of which the
		     district and city are kept and the coordinate is discarded. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeCoarseLocation</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- Derived from HealthKit, never the raw samples: a chronotype band, a
		     median wake time, and sport names with session counts. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeFitness</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- What the distillation actually is: songs, artists, playlists,
		     subscriptions and liked videos from the apps the user connected,
		     and now podcast shows and downloaded episodes — including how far
		     through one somebody got, which is the same kind of usage fact as a
		     play count and belongs under the same declaration. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUsageData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- Age and gender typed on the biographics rows, and calendar events:
		     titles, locations, organisers and dates. One entry because Apple has
		     no calendar-specific type and a second "other" dict would be the same
		     declaration twice.

		     The calendar half is the only thing here carrying *other people's*
		     information — an event called "Dinner with Sam at 14 Elm St" names
		     someone who never agreed to anything. Events are kept whole rather
		     than reduced to counts, the way HealthKit is, because the titles are
		     the signal: a booking Eventbrite or Ticketmaster wrote into the
		     calendar is the strongest interest claim this app can see. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherDataTypes</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- Messages, which now includes recorded audio.
		     A voice memo is a message like any other: it is held to record, kept
		     on the device until the send arrow is tapped, then uploaded to the
		     private `chat-media` bucket and readable only by the two people in
		     that conversation. Discarding a take deletes the file.
		     Declared here rather than left under "other" because audio is the
		     kind of thing a reader of this manifest would look for by name, and
		     a manifest that is technically complete but hard to search is the
		     kind that ages into a rejection. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeAudioData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>

	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<!-- UserDefaults: the tree seed, the ban list, and the debug launch
			     arguments. CA92.1 is the reason for access confined to the app
			     itself — nothing here is shared with an app group or another
			     process. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
